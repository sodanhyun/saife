# ── Gemini (Spring AI google-genai) ──
# Spring AI 프로퍼티 spring.ai.google.genai.api-key 에 바인딩됨
GEMINI_API_KEY=
# 2.5 계열은 신규 키에 404. 3.6/3.7/3.8-flash 사용 가능 (2026-09-20 실측)
GEMINI_CHAT_MODEL=gemini-3.8-flash

# ── DB ──
DB_USERNAME=saife
DB_PASSWORD=
DB_NAME=saife

# ── JWT ──
JWT_SECRET=

# ── 공공데이터포털 서비스키 (디코딩 키를 넣고 클라이언트가 인코딩하게 둔다) ──
# 4종이 같은 게이트웨이(B552468)를 쓰지만 키는 데이터셋별로 발급됨
KOSHA_KEY_FATALITY=
KOSHA_KEY_GUIDE=
KOSHA_KEY_DISASTER=
KOSHA_KEY_MSDS=

# ── 법제처 국가법령정보 OPEN API ──
# serviceKey가 아니라 OC(기관코드). 쿼리 파라미터명도 OC
LAW_OC=
